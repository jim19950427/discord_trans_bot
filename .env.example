# 必填
DISCORD_TOKEN=your_bot_token_here

# 選填：追蹤訊息上限（預設 1500）
# MAX_CLUSTER_ENTRIES=1500

# 選填：資料檔案路徑（預設為 /data/ 目錄下）
# CONFIG_FILE=/data/channel_config.json
# GLOSSARY_FILE=/data/glossary.json
# SUBSTITUTIONS_FILE=/data/substitutions.json
# USER_LANGS_FILE=/data/user_langs.json
# CLUSTERS_FILE=/data/msg_clusters.json
# THREAD_CLUSTERS_FILE=/data/thread_clusters.json
# CHANNEL_PINS_FILE=/data/channel_pins.json
